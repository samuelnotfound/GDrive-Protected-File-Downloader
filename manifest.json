{
  "manifest_version": 3,
  "name": "GDrive View-Only PDF & Video Downloader",
  "version": "1.85.1",
  "description": "Downloads view-only Google Drive PDFs and videos. DOM-based quality detection, compact inline Material quality picker, automatic audio selection and PDF OCR pipeline.",
  "permissions": [
    "scripting",
    "storage",
    "webRequest",
    "offscreen",
    "webNavigation"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "GDrive PDF & Video Downloader",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/content/shared/utils.js",
        "src/content/automation/autoplay.js",
        "src/content/automation/quality-trigger.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_origin_as_fallback": true,
      "world": "ISOLATED",
      "match_about_blank": true
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/content/media/network-bridge.js",
        "src/content/media/media-mute-guard.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_origin_as_fallback": true,
      "world": "MAIN",
      "match_about_blank": true
    },
    {
      "matches": [
        "https://drive.google.com/*",
        "https://*.drive.google.com/*",
        "https://*.googleusercontent.com/*"
      ],
      "js": [
        "src/content/shared/utils.js",
        "src/content/drive/ui.js",
        "src/content/drive/pdf/capture.js",
        "src/content/drive/pdf/ocr.js",
        "src/content/drive/pdf/writer.js",
        "src/content/drive/pdf.js",
        "src/content/drive/video-overlay.js",
        "src/content/drive/video/context.js",
        "src/content/drive/video/quality-picker.js",
        "src/content/drive/video/bridge.js",
        "src/content/drive/video.js",
        "src/content/drive/bootstrap.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_origin_as_fallback": true,
      "world": "ISOLATED"
    }
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "vendor/*"
      ],
      "matches": [
        "https://drive.google.com/*",
        "https://*.drive.google.com/*",
        "<all_urls>"
      ]
    }
  ]
}
