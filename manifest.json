{
  "manifest_version": 3,
  "version": "1.9.6",
  "name": "GDrive Protected File Downloader",
  "description": "Download view-only / protected Google Drive PDFs and videos.",
  "permissions": [
    "tabs",
    "scripting",
    "storage",
    "webRequest",
    "offscreen",
    "webNavigation"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/content/shared/utils.js",
        "src/content/automation/quality-trigger.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_origin_as_fallback": true,
      "world": "ISOLATED",
      "match_about_blank": true
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/content/media/network-bridge.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_origin_as_fallback": true,
      "world": "MAIN",
      "match_about_blank": true
    },
    {
      "matches": [
        "https://drive.google.com/*",
        "https://*.drive.google.com/*",
        "https://*.googleusercontent.com/*"
      ],
      "js": [
        "src/content/shared/utils.js",
        "src/content/drive/ui.js",
        "src/content/drive/pdf/capture.js",
        "src/content/drive/pdf/writer.js",
        "src/content/drive/pdf.js",
        "src/content/drive/video-overlay.js",
        "src/content/drive/video/context.js",
        "src/content/drive/video/quality-picker.js",
        "src/content/drive/video/bridge.js",
        "src/content/drive/video.js",
        "src/content/drive/bootstrap.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_origin_as_fallback": true,
      "world": "ISOLATED"
    }
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "vendor/mp4-remux-worker.js",
        "vendor/mp4-remux.iife.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "action": {
    "default_title": "GDrive Protected File Downloader"
  }
}
